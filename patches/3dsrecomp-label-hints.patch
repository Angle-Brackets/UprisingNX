+/// the hinted places in the middle of a function's code that are not one of
+/// its labels, where computed branches the analysis could not follow land,
+/// such as a hand-written decoder's jumps into its own unrolled loops. made
+/// labels, the function's dispatch takes its own indirect branches there and
+/// the host can enter there, instead of interpreting until the next label.
+pub fn label_hints(analysis: &mut Analysis, hinted: &[u32]) -> usize {
+    let mut added = std::collections::BTreeSet::new();
+    for function in analysis.functions.values_mut() {
+        let thumb = (function.mode == Mode::Thumb) as u32;
+        for &address in hinted {
+            if address & 1 != thumb {
+                continue;
+            }
+            let at = address & !1;
+            if function.instructions.binary_search(&at).is_ok() && function.labels.insert(at) {
+                added.insert(address);
+            }
+        }
+    }
+    added.len()
+}
